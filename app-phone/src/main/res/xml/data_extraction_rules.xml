<?xml version="1.0" encoding="utf-8"?>
<!--
    Mirrors android:allowBackup="false": opt out of both cloud backup and
    device-to-device transfer. Tokens live in a SharedPreferences file whose
    values are encrypted with a Tink AEAD keyset wrapped by the Android
    Keystore, and must not leave the device.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
